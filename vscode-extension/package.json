{
  "name": "deplens",
  "displayName": "DepLens",
  "description": "Local-first dependency health: usage analysis, impact simulator, decisions tracking, and inline fix actions — data never leaves your machine.",
  "version": "0.2.0",
  "publisher": "deplens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2025sl93002-lang/DepLens-v1"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["dependencies", "security", "npm", "health", "vulnerabilities"],
  "activationEvents": [
    "workspaceContains:**/package.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "deplens.deps",
          "name": "DepLens",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "deplens.refresh",
        "title": "DepLens: Refresh",
        "icon": "$(sync)"
      },
      {
        "command": "deplens.openDetail",
        "title": "DepLens: Open Package Detail"
      },
      {
        "command": "deplens.simulateImpact",
        "title": "DepLens: Simulate Impact",
        "icon": "$(beaker)"
      },
      {
        "command": "deplens.applyFix",
        "title": "DepLens: Apply Fix"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deplens.refresh",
          "when": "view == deplens.deps",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "deplens.simulateImpact",
          "when": "view == deplens.deps && viewItem =~ /deplensPackage/",
          "group": "deplens@1"
        },
        {
          "command": "deplens.applyFix",
          "when": "view == deplens.deps && viewItem == deplensPackageUpgradable",
          "group": "deplens@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
